# UK Macro Crew Environment Configuration
# Copy this file to .env and fill in your actual API keys

# Required: OpenAI API Key for LLM agents (gpt-6-luna by default)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Required: Exa API Key for web search and data retrieval
# Get your key from: https://exa.ai/
EXA_API_KEY=your_exa_api_key_here

# Optional: Model selection (default: gpt-6-luna).
# gpt-4o, gpt-4o-mini, gpt-4.1 and gpt-4.1-mini leave the API on 2027-01-14.
# OpenAI's replacement for those models is gpt-6-luna.
MODEL=gpt-6-luna

# Optional: reasoning effort for models that accept it (default: none).
# gpt-6-luna tool calling on Chat Completions requires "none".
OPENAI_REASONING_EFFORT=none

# Error Handling & Timeout Configuration
# Maximum iterations per agent before stopping (default: 8)
AGENT_MAX_ITERATIONS=8

# Maximum retries per agent on failure (default: 2)
AGENT_MAX_RETRIES=2

# Maximum execution time per agent in seconds (default: 900 = 15 minutes)
AGENT_MAX_EXECUTION_TIME=900

# Maximum requests per minute per agent (default: 150)
AGENT_MAX_RPM=150

# Stop execution immediately on first error (default: true)
CREW_FAIL_FAST=true

# Maximum requests per minute for the crew (default: 100)
CREW_MAX_RPM=100

# Paid CLI jobs fail closed until explicitly enabled. No keys are needed for statistics.
FINSTATS_AI_ENABLED=false
FINSTATS_AI_DAILY_ATTEMPTS=1
FINSTATS_AI_MAX_OUTPUT_TOKENS=4096
# Optional: private, owner-only directory outside repository/web roots.
# FINSTATS_AI_STATE_DIR=/home/finstats/.local/state/finstats-ai
