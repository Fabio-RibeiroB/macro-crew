[Unit]
Description=Collect and publish verified FinStats figures
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=finstats
Group=finstats
WorkingDirectory=/home/finstats/public_html/macro-crew
Environment=PYTHONPATH=/home/finstats/public_html/macro-crew/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/finstats/public_html/macro-crew/.venv/bin/python -m finstats.delivery --state-dir /home/finstats/.local/state/finstats-shadow --output-dir /home/finstats/published-data
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/finstats/.local/state/finstats-shadow /home/finstats/published-data
StandardOutput=journal
StandardError=journal
