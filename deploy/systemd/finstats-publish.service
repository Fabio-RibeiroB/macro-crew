[Unit]
Description=Collect and publish verified FinStats figures
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=finstats
Group=finstats
WorkingDirectory=/home/finstats/public_html/macro-crew
Environment=PYTHONPATH=/home/finstats/public_html/macro-crew/src
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/home/finstats/.local/share/finstats-collector/bin/python -m finstats.delivery --state-dir /home/finstats/.local/state/finstats-shadow --output-dir /home/finstats/published-data
TimeoutStartSec=5min
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
InaccessiblePaths=-/home/finstats/.env -/home/finstats/.ssh -/home/finstats/.config
MemoryMax=256M
TasksMax=32
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/finstats/.local/state/finstats-shadow /home/finstats/published-data
StandardOutput=journal
StandardError=journal
